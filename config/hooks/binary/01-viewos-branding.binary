#!/bin/bash
# binary hook: ViewOS ISO branding
# Runs after the chroot is built, on the binary image

set -e

# GRUB theme
mkdir -p binary/boot/grub/themes/viewos
cat > binary/boot/grub/themes/viewos/theme.txt << 'EOF'
# ViewOS GRUB2 theme
# Generated by live-build hook

+ boot_menu {
    left = 10%
    width = 80%
    top = 20%
    height = 60%
    item_font = "DejaVu Sans 16"
    item_color = "#cdd6f4"
    selected_item_color = "#f5e0dc"
    item_height = 40
    item_padding = 10
    icon_width = 48
    icon_height = 48
    item_icon_space = 10
}

+ progress_bar {
    id = "__timeout__"
    left = 10%
    top = 85%
    width = 80%
    height = 12
    bg_color = "#313244"
    fg_color = "#89b4fa"
    border_color = "#45475a"
    text_color = "#cdd6f4"
    font = "DejaVu Sans 14"
    text = "@TIMEOUT_NOTIFICATION_LONG@"
    show_text = true
}

+ vbox {
    left = 0
    top = 0
    width = 100%
    height = 100%
    + hbox {
        width = 100%
        + label {
            text = "ViewOS"
            font = "DejaVu Sans Bold 32"
            color = "#89b4fa"
            align = "center"
        }
    }
    + hbox {
        width = 100%
        + label {
            text = "Head-Tracked Desktop"
            font = "DejaVu Sans 14"
            color = "#a6adc8"
            align = "center"
        }
    }
}
EOF

# Copy background for GRUB (placeholder)
# convert -size 1920x1080 xc:'#1e1e2e' binary/boot/grub/themes/viewos/background.png 2>/dev/null || true

# Update GRUB config to use theme
if [ -f binary/boot/grub/grub.cfg ]; then
    sed -i '/^set theme=/d' binary/boot/grub/grub.cfg
    echo 'set theme=/boot/grub/themes/viewos/theme.txt' >> binary/boot/grub/grub.cfg
fi

# Plymouth theme
mkdir -p binary/usr/share/plymouth/themes/viewos
cat > binary/usr/share/plymouth/themes/viewos/viewos.plymouth << 'EOF'
[Plymouth Theme]
Name=ViewOS
Description=ViewOS boot splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/viewos
ScriptFile=/usr/share/plymouth/themes/viewos/viewos.script
EOF

cat > binary/usr/share/plymouth/themes/viewos/viewos.script << 'EOF'
// ViewOS Plymouth theme script
// Minimal text-based splash

Window.SetBackgroundTopColor(0.12, 0.12, 0.18);
Window.SetBackgroundBottomColor(0.12, 0.12, 0.18);

let text = "ViewOS";
let font = Font("DejaVu Sans", 48);
let color = [0.54, 0.71, 0.98];  // #89b4fa

let w = Window.GetWidth();
let h = Window.GetHeight();

let text_width = font.GetTextWidth(text);
let text_height = font.GetTextHeight();

let x = (w - text_width) / 2;
let y = (h - text_height) / 2;

let label = Sprite();
label.SetPosition(x, y);
label.SetText(text, font, color);
EOF

# Set as default theme
mkdir -p binary/etc/plymouth
cat > binary/etc/plymouth/plymouthd.conf << 'EOF'
[Daemon]
Theme=viewos
ShowDelay=0
EOF

# Update initramfs to include theme (runs in chroot, but we can't here)
# This will be handled by the chroot hook or on first boot

# Add ViewOS identifier
echo "ViewOS $(date +%Y%m%d)" > binary/VIEWOS_VERSION

echo "ViewOS binary hook completed"