# ViewOS .gitignore

# Build outputs
/build/
/iso/
/binary.hybrid.iso
/live-image-*.iso
/*.iso
/*.iso.sha256

# live-build
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/source
/cache/

# Package build output
#
# Note the split below: the *hand-written* payload of each package (systemd
# units, default configuration, licence texts) is committed, because it is
# source. Only the artefacts produced by compiling are ignored.
#
# /packages/viewos-*/usr/
/packages/build/
/packages/*.deb
/packages/*.changes
/packages/*.dsc
/packages/*.buildinfo

# Built KWin effect plugin, staged into the package tree by
# packages/build-kwin-effect.sh
/packages/viewos-kwin-effect/usr/lib/

# Built Rust binary, staged into the package tree by
# packages/build-face-daemon.sh
/packages/viewos-face-daemon/usr/bin/

# The YuNet model, downloaded and hash-checked by
# packages/fetch-yunet-model.sh rather than committed. Its licence text next to
# it *is* committed.
/packages/viewos-face-daemon/usr/share/viewos/models/*.onnx

# Rust
#
# Cargo.lock is committed. This crate builds an application, not a library, so
# the lock file is part of the source: without it, a rebuild months from now
# would pick up different dependency versions and produce a different binary
# from the same commit.
/face-tilt/daemon/target/

# C++ KWin effect
/face-tilt/kwin-effect/build/
/face-tilt/kwin-effect/*.so

# APT repository, generated by .github/workflows/apt-repo.yml.
# Note repo/conf/ is *not* ignored: the reprepro configuration is source.
/repo/dists/
/repo/pool/
/repo/*.deb
/repo/*.gpg
/repo/*.asc

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary files
*.tmp
*.bak
*.orig

# Logs
*.log

# Secrets (never commit)
/secrets/
*.key
*.pem

# Local config overrides
/local.conf
/local.env
