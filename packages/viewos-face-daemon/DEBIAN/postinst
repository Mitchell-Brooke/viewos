#!/bin/sh
# postinst for viewos-face-daemon
set -e

case "$1" in
    configure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            # A user unit cannot be enabled from a package maintainer script
            # in a meaningful way (the enabling user is not necessarily the
            # user who will run it), so we only reload unit state here.
        fi
        ;;
esac

#DEBHELPER#

exit 0
