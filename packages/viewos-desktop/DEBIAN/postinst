#!/bin/sh
# postinst for viewos-desktop
#
# This is a metapackage: it ships no files, so there is nothing to install.
# We only need to make sure the boot-time service units are enabled, which
# Debian packages normally do themselves. The only real work here is ensuring
# the display manager is enabled, because a headless install that leaves sddm
# disabled will drop to a TTY after reboot.
set -e

case "$1" in
    configure)
        if command -v systemctl >/dev/null 2>&1; then
            # sddm enables itself via its own postinst; this is a no-op if
            # already enabled and harmless if the system is containerised.
            systemctl enable sddm.service >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
