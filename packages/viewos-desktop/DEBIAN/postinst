#!/bin/bash
# postinst script for viewos-desktop

set -e

# Enable and start services
systemctl enable sddm.service || true
systemctl enable NetworkManager.service || true
systemctl enable bluetooth.service || true
systemctl enable tlp.service || true

# Set default target to graphical
systemctl set-default graphical.target || true

# Configure Plymouth theme (placeholder)
# plymouth-set-default-theme viewos || true
# update-initramfs -u || true

# Add user to common groups (handled by Calamares during install)
# This runs on live system boot
if [ -n "$USER" ] && [ "$USER" != "root" ]; then
    usermod -a -G video,render,input,plugdev,netdev,bluetooth "$USER" 2>/dev/null || true
fi

exit 0